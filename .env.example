# Resend email delivery for contact & quote forms
# Get an API key at https://resend.com

RESEND_API_KEY=

# Inbox that receives form submissions
CONTACT_EMAIL=sankofaglobaltrading@gmail.com

# Verified sender address. Until you verify a domain in Resend,
# you can use the shared test sender below (only delivers to your own
# Resend account email). Once sankofaglobal.com is verified, switch to
# something like: Sankofa Global <noreply@sankofaglobal.com>
FROM_EMAIL=Sankofa Global <onboarding@resend.dev>
